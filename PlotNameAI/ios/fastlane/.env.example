# Copy to fastlane/.env and fill in. fastlane auto-loads fastlane/.env.
# Do NOT commit the real .env or the .p8 file (both are gitignored).
#
# Same variable names as the root fastlane setup, so the existing GitHub
# secrets (ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8_BASE64 / TANAMIRU_TEAM_ID)
# work unchanged for this app.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/Users/you/private_keys/AuthKey_XXXXXXXXXX.p8
TANAMIRU_TEAM_ID=XXXXXXXXXX

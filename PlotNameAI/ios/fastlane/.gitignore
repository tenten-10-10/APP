# Secrets — never commit. The root .gitignore's "fastlane/.env" rule is
# anchored to the repo root, so it does NOT cover this nested fastlane dir.
.env

# fastlane build/report artifacts (mirrors the root .gitignore rules)
report.xml
Preview.html
test_output/

# Raw simulator screenshots are regenerated by the `screenshots` lane…
screenshots/**/*.png
# …but DO track the finished App Store marketing screenshots (ja).
!screenshots/ja/*.png

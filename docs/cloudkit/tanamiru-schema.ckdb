DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE CD_CodeAlias (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset ASSET,
        CD_isActive INT64 QUERYABLE SORTABLE,
        CD_lastScannedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_publicCode STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_publicCode_ckAsset ASSET,
        CD_retiredAt TIMESTAMP QUERYABLE SORTABLE,
        CD_scanCount INT64 QUERYABLE SORTABLE,
        CD_targetTypeRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_targetTypeRaw_ckAsset ASSET,
        CD_location STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_product STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_project STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Folder (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset ASSET,
        CD_name STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset ASSET,
        CD_sortIndex INT64 QUERYABLE SORTABLE,
        CD_updatedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_parent STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_project STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_InventoryEvent (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_actorDeviceID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_actorDeviceID_ckAsset ASSET,
        CD_actorDisplayName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_actorDisplayName_ckAsset ASSET,
        CD_borrowerName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_borrowerName_ckAsset ASSET,
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_dueAt TIMESTAMP QUERYABLE SORTABLE,
        CD_eventTypeRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_eventTypeRaw_ckAsset ASSET,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset ASSET,
        CD_isCorrection INT64 QUERYABLE SORTABLE,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset ASSET,
        CD_occurredAt TIMESTAMP QUERYABLE SORTABLE,
        CD_quantityDelta DOUBLE QUERYABLE SORTABLE,
        CD_correctsEvent STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_destinationLocation STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_product STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_project STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceLocation STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Location (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset ASSET,
        CD_kindRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset ASSET,
        CD_name STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset ASSET,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset ASSET,
        CD_sortIndex INT64 QUERYABLE SORTABLE,
        CD_updatedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_parent STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_project STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Product (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cachedQuantity DOUBLE QUERYABLE SORTABLE,
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset ASSET,
        CD_isArchived INT64 QUERYABLE SORTABLE,
        CD_minimumStock DOUBLE QUERYABLE SORTABLE,
        CD_name STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset ASSET,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset ASSET,
        CD_photoThumbnail BYTES,
        CD_photoThumbnail_ckAsset ASSET,
        CD_sku STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sku_ckAsset ASSET,
        CD_trackingModeRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_trackingModeRaw_ckAsset ASSET,
        CD_unitName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unitName_ckAsset ASSET,
        CD_updatedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_defaultLocation STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_folder STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_project STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Project (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_archivedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_colorKey STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_colorKey_ckAsset ASSET,
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_defaultTrackingModeRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_defaultTrackingModeRaw_ckAsset ASSET,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset ASSET,
        CD_isPinned INT64 QUERYABLE SORTABLE,
        CD_isSample INT64 QUERYABLE SORTABLE,
        CD_name STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset ASSET,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset ASSET,
        CD_ownerDisplayName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerDisplayName_ckAsset ASSET,
        CD_sortIndex INT64 QUERYABLE SORTABLE,
        CD_updatedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_StockUnit (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cachedQuantity DOUBLE QUERYABLE SORTABLE,
        CD_createdAt TIMESTAMP QUERYABLE SORTABLE,
        CD_expiresAt TIMESTAMP QUERYABLE SORTABLE,
        CD_id STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset ASSET,
        CD_kindRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset ASSET,
        CD_lotNumber STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lotNumber_ckAsset ASSET,
        CD_note STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset ASSET,
        CD_serialNumber STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_serialNumber_ckAsset ASSET,
        CD_statusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset ASSET,
        CD_updatedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_location STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_product STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_project STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

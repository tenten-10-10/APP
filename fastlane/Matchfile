# fastlane match — shared App Store signing assets.
#
# The encrypted distribution certificate + provisioning profile live in a
# DEDICATED PRIVATE repo (never in this public app repo). Authentication to that
# repo is via MATCH_GIT_BASIC_AUTHORIZATION (base64 "user:token"); the assets are
# encrypted with MATCH_PASSWORD. Apple Developer Portal auth uses the App Store
# Connect API key (passed in the Fastfile lane, not here).
#
# Override the repo with the MATCH_GIT_URL secret if you named it differently.
# NOTE: an unset GitHub secret is passed through as an EMPTY string (not nil), and
# in Ruby "" is truthy — so test for empty explicitly, otherwise match would try
# to clone '' and fail with "The empty string is not a valid path".
_match_git_url = ENV["MATCH_GIT_URL"].to_s
_match_git_url = "https://github.com/tenten-10-10/tanamiru-certs.git" if _match_git_url.empty?
git_url(_match_git_url)
storage_mode("git")

type("appstore")
app_identifier(["com.tenten.tanamiru"])
